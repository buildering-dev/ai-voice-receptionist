# Where this server can be reached from the internet (Vapi sends tool calls here)
SERVER_URL=https://voice.example.com
# Any long random string. push_assistant.py puts it on the assistant; the server checks it.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Protects /admin (bookings, messages, call summaries). Leave empty to disable.
ADMIN_TOKEN=change-me-too

# Only for scripts/push_assistant.py. Your PRIVATE Vapi key. Keep it out of git.
VAPI_API_KEY=

# For the browser demo page (/). The PUBLIC key is safe to expose in a web page.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Optional: send bookings, messages and call summaries to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model and voice (any model/voice Vapi supports)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
# Voice. Default: Cartesia "Australian Narrator Lady". Any voice Vapi supports works (e.g. VOICE_PROVIDER=vapi, VOICE_ID=Clara).
VOICE_PROVIDER=cartesia
VOICE_ID=8985388c-1332-4ce7-8d55-789628aa3df4
VOICE_MODEL=sonic-3
MAX_CALL_SECONDS=600
